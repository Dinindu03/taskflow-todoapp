APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=taskflow
JWT_SECRET_KEY=replace-with-a-local-development-secret-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=taskflow_auth
CSRF_COOKIE_NAME=taskflow_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080
FRONTEND_PORT=8080
LOG_LEVEL=INFO
